# Copy this file to `.env` and fill in your API keys.
# `.env` is gitignored.

# DeepSeek (for deepseek-reasoner / deepseek-chat)
# Get a key at https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# Alibaba DashScope (for qwq-32b, r1-distill-qwen-7b, qwen3-30b-a3b-thinking-2507)
# Get a key at https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=

# OpenAI (for the gpt-4o-mini external judge used in the Appendix robustness check)
# Optional — leave empty if you only need self-judge results.
OPENAI_API_KEY=

# Experiment scale: "pilot" (tiny smoke test), "A" (150 MATH x 3, the paper's config), "full"
SCALE=A
